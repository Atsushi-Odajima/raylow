{
  "schemaVersion": 1,
  "kind": "T13_answer",
  "title": "答弁書",
  "scope": "court",
  "recipientTypes": [
    "court"
  ],
  "fields": [
    {
      "key": "office_name",
      "type": "text",
      "label": "自事務所名",
      "source": "office",
      "sourcePath": "office.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_postcode",
      "type": "text",
      "label": "事務所郵便番号",
      "source": "office",
      "sourcePath": "office.postcode",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_address",
      "type": "text",
      "label": "事務所所在地",
      "source": "office",
      "sourcePath": "office.address",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_phone",
      "type": "text",
      "label": "事務所電話番号",
      "source": "office",
      "sourcePath": "office.phone",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_fax",
      "type": "text",
      "label": "事務所ＦＡＸ番号",
      "source": "office",
      "sourcePath": "office.fax",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "lawyer_name",
      "type": "text",
      "label": "担当弁護士氏名",
      "source": "office",
      "sourcePath": "lawyer.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_organization",
      "type": "text",
      "label": "宛先の所属・組織",
      "source": "recipient",
      "sourcePath": "recipient.organization",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_name",
      "type": "text",
      "label": "宛名",
      "source": "recipient",
      "sourcePath": "recipient.name",
      "required": true,
      "defaultPolicy": "from_source",
      "validationRules": [
        {
          "rule": "noDoubleHonorific"
        }
      ],
      "description": "敬称を含めない。敬称は recipient_honorific（所内設定）で付加し、二重敬称を検出する。"
    },
    {
      "key": "recipient_honorific",
      "type": "text",
      "label": "敬称",
      "source": "recipient",
      "sourcePath": "recipient.honorific",
      "required": false,
      "defaultPolicy": "from_source",
      "description": "人物「先生/様」、組織「御中」等を所内設定から選択。"
    },
    {
      "key": "matter_title",
      "type": "text",
      "label": "事件名（案件名）",
      "source": "matter",
      "sourcePath": "matter.title",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "case_number",
      "type": "text",
      "label": "事件番号（原文）",
      "source": "matter",
      "sourcePath": "matter.case_number",
      "required": true,
      "defaultPolicy": "from_source",
      "description": "先頭 0 や全角数字を含む文字列として保持する。"
    },
    {
      "key": "court_name",
      "type": "text",
      "label": "裁判所",
      "source": "matter",
      "sourcePath": "matter.court",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "court_department",
      "type": "text",
      "label": "係属部",
      "source": "matter",
      "sourcePath": "matter.court_department",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "plaintiff_name",
      "type": "text",
      "label": "原告（表示）",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "description": "依頼者/相手方のどちらが原告かは案件ごとに人が指定する。氏名一致だけで置換しない。"
    },
    {
      "key": "defendant_name",
      "type": "text",
      "label": "被告（表示）",
      "source": "input",
      "required": true,
      "defaultPolicy": "none"
    },
    {
      "key": "answer_items",
      "type": "array",
      "label": "請求の趣旨に対する答弁",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "itemFields": [
        {
          "key": "no",
          "type": "text",
          "label": "番号",
          "required": true,
          "maxGraphemes": 10
        },
        {
          "key": "text",
          "type": "multiline",
          "label": "答弁",
          "required": true
        }
      ],
      "maxItems": 50,
      "legalJudgement": true
    },
    {
      "key": "admissions",
      "type": "array",
      "label": "請求原因に対する認否（段落単位）",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "itemFields": [
        {
          "key": "para_no",
          "type": "text",
          "label": "段落番号",
          "required": true,
          "maxGraphemes": 20
        },
        {
          "key": "claim_text",
          "type": "multiline",
          "label": "請求原因の記載（原文）",
          "required": true
        },
        {
          "key": "admission",
          "type": "enum",
          "label": "認否",
          "required": true,
          "options": [
            {
              "value": "未入力",
              "label": "未入力"
            },
            {
              "value": "認める",
              "label": "認める"
            },
            {
              "value": "否認",
              "label": "否認"
            },
            {
              "value": "不知",
              "label": "不知"
            },
            {
              "value": "自由記載",
              "label": "自由記載"
            }
          ]
        },
        {
          "key": "admission_note",
          "type": "multiline",
          "label": "自由記載・理由",
          "required": false
        }
      ],
      "maxItems": 500,
      "description": "段落単位で未入力/認める/否認/不知/自由記載を選べるが自動選択しない。",
      "legalJudgement": true
    },
    {
      "key": "evidence_refs",
      "type": "array",
      "label": "証拠参照（証拠方法）",
      "source": "input",
      "required": false,
      "defaultPolicy": "none",
      "itemFields": [
        {
          "key": "label",
          "type": "text",
          "label": "証拠番号（表示ラベル）",
          "required": true,
          "maxGraphemes": 50
        },
        {
          "key": "title",
          "type": "text",
          "label": "標目",
          "required": false
        }
      ],
      "maxItems": 200
    }
  ],
  "bodyTag": "body_text",
  "attachments": true,
  "honorificKeys": [
    "recipient_name"
  ],
  "notes": "認否は段落単位の enum（未入力/認める/否認/不知/自由記載）で legalJudgement。サンプルでは未入力のまま。回答書（T02）とは別種類。"
}
