{
  "schemaVersion": 1,
  "kind": "T05_demand_letter",
  "title": "催告書",
  "scope": "negotiation",
  "recipientTypes": [
    "opponent",
    "opponent_agent"
  ],
  "fields": [
    {
      "key": "office_name",
      "type": "text",
      "label": "自事務所名",
      "source": "office",
      "sourcePath": "office.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_postcode",
      "type": "text",
      "label": "事務所郵便番号",
      "source": "office",
      "sourcePath": "office.postcode",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_address",
      "type": "text",
      "label": "事務所所在地",
      "source": "office",
      "sourcePath": "office.address",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_phone",
      "type": "text",
      "label": "事務所電話番号",
      "source": "office",
      "sourcePath": "office.phone",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_fax",
      "type": "text",
      "label": "事務所ＦＡＸ番号",
      "source": "office",
      "sourcePath": "office.fax",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "lawyer_name",
      "type": "text",
      "label": "担当弁護士氏名",
      "source": "office",
      "sourcePath": "lawyer.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_organization",
      "type": "text",
      "label": "宛先の所属・組織",
      "source": "recipient",
      "sourcePath": "recipient.organization",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_name",
      "type": "text",
      "label": "宛名",
      "source": "recipient",
      "sourcePath": "recipient.name",
      "required": true,
      "defaultPolicy": "from_source",
      "validationRules": [
        {
          "rule": "noDoubleHonorific"
        }
      ],
      "description": "敬称を含めない。敬称は recipient_honorific（所内設定）で付加し、二重敬称を検出する。"
    },
    {
      "key": "recipient_honorific",
      "type": "text",
      "label": "敬称",
      "source": "recipient",
      "sourcePath": "recipient.honorific",
      "required": false,
      "defaultPolicy": "from_source",
      "description": "人物「先生/様」、組織「御中」等を所内設定から選択。"
    },
    {
      "key": "matter_title",
      "type": "text",
      "label": "案件名",
      "source": "matter",
      "sourcePath": "matter.title",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "client_name",
      "type": "text",
      "label": "依頼者",
      "source": "matter",
      "sourcePath": "matter.client_name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "opponent_name",
      "type": "text",
      "label": "相手方",
      "source": "matter",
      "sourcePath": "matter.opponent_name",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "subject",
      "type": "text",
      "label": "件名",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "maxGraphemes": 100
    },
    {
      "key": "claim_description",
      "type": "multiline",
      "label": "請求内容",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "outputFormat": "multiline"
    },
    {
      "key": "claim_amount",
      "type": "money",
      "label": "請求金額（原文/解析値）",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "outputFormat": "plain",
      "validationRules": [
        {
          "rule": "jpyInteger"
        }
      ],
      "description": "金額原文（raw）をそのまま差し込む。解析値（JPY 整数 decimal string）は別に保持し、値を黙って変更しない。"
    },
    {
      "key": "claim_basis_ref",
      "type": "multiline",
      "label": "根拠の参照",
      "source": "input",
      "required": false,
      "defaultPolicy": "none",
      "outputFormat": "multiline"
    },
    {
      "key": "payment_deadline_raw",
      "type": "date",
      "label": "期限（原文）",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "outputFormat": "plain",
      "validationRules": [
        {
          "rule": "isoDateOrRaw"
        }
      ],
      "description": "原文（raw）を保持し、そのまま差し込む。ISO 値は解析候補として別に保持する。"
    },
    {
      "key": "payment_destination",
      "type": "multiline",
      "label": "支払先",
      "source": "input",
      "required": false,
      "defaultPolicy": "none",
      "outputFormat": "multiline"
    }
  ],
  "bodyTag": "body_text",
  "attachments": false,
  "honorificKeys": [
    "recipient_name"
  ],
  "notes": "金額は原文（raw）と解析値（decimal）を分けて保持し、原文を差し込む。利息・時効を自動算定しない。期限は原文を保持。"
}
