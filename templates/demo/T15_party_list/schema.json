{
  "schemaVersion": 1,
  "kind": "T15_party_list",
  "title": "当事者目録",
  "scope": "court",
  "recipientTypes": [
    "court"
  ],
  "fields": [
    {
      "key": "office_name",
      "type": "text",
      "label": "自事務所名",
      "source": "office",
      "sourcePath": "office.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_postcode",
      "type": "text",
      "label": "事務所郵便番号",
      "source": "office",
      "sourcePath": "office.postcode",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_address",
      "type": "text",
      "label": "事務所所在地",
      "source": "office",
      "sourcePath": "office.address",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_phone",
      "type": "text",
      "label": "事務所電話番号",
      "source": "office",
      "sourcePath": "office.phone",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_fax",
      "type": "text",
      "label": "事務所ＦＡＸ番号",
      "source": "office",
      "sourcePath": "office.fax",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "lawyer_name",
      "type": "text",
      "label": "担当弁護士氏名",
      "source": "office",
      "sourcePath": "lawyer.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_organization",
      "type": "text",
      "label": "宛先の所属・組織",
      "source": "recipient",
      "sourcePath": "recipient.organization",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_name",
      "type": "text",
      "label": "宛名",
      "source": "recipient",
      "sourcePath": "recipient.name",
      "required": true,
      "defaultPolicy": "from_source",
      "validationRules": [
        {
          "rule": "noDoubleHonorific"
        }
      ],
      "description": "敬称を含めない。敬称は recipient_honorific（所内設定）で付加し、二重敬称を検出する。"
    },
    {
      "key": "recipient_honorific",
      "type": "text",
      "label": "敬称",
      "source": "recipient",
      "sourcePath": "recipient.honorific",
      "required": false,
      "defaultPolicy": "from_source",
      "description": "人物「先生/様」、組織「御中」等を所内設定から選択。"
    },
    {
      "key": "matter_title",
      "type": "text",
      "label": "事件名（案件名）",
      "source": "matter",
      "sourcePath": "matter.title",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "case_number",
      "type": "text",
      "label": "事件番号（原文）",
      "source": "matter",
      "sourcePath": "matter.case_number",
      "required": true,
      "defaultPolicy": "from_source",
      "description": "先頭 0 や全角数字を含む文字列として保持する。"
    },
    {
      "key": "court_name",
      "type": "text",
      "label": "裁判所",
      "source": "matter",
      "sourcePath": "matter.court",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "parties",
      "type": "array",
      "label": "当事者",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "itemFields": [
        {
          "key": "role_label",
          "type": "text",
          "label": "立場（原告/被告等）",
          "required": true,
          "maxGraphemes": 20
        },
        {
          "key": "name",
          "type": "text",
          "label": "氏名・名称",
          "required": true
        },
        {
          "key": "address",
          "type": "multiline",
          "label": "住所",
          "required": false
        },
        {
          "key": "representative",
          "type": "text",
          "label": "法人代表者",
          "required": false
        },
        {
          "key": "agent",
          "type": "multiline",
          "label": "代理人（複数は改行区切り）",
          "required": false
        }
      ],
      "maxItems": 50,
      "description": "複数当事者対応。代理人は当事者ごとに記載し、氏名一致で自動補完しない。"
    }
  ],
  "bodyTag": "body_text",
  "attachments": false,
  "honorificKeys": [
    "recipient_name"
  ],
  "notes": "当事者配列・立場・住所・法人代表者・代理人。単純な行繰返し（縦結合なし）。同姓同名の代理人は所属で区別。"
}
