      "sourcePath": "recipient.organization",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_name",
      "type": "text",
      "label": "宛名",
      "source": "recipient",
      "sourcePath": "recipient.name",
      "required": true,
      "defaultPolicy": "from_source",
      "validationRules": [
        {
          "rule": "noDoubleHonorific"
        }
      ],
      "description": "敬称を含めない。敬称は recipient_honorific（所内設定）で付加し、二重敬称を検出する。"
    },
    {
      "key": "recipient_honorific",
      "type": "text",
      "label": "敬称",
      "source": "recipient",
      "sourcePath": "recipient.honorific",
      "required": false,
      "defaultPolicy": "from_source",
      "description": "人物「先生/様」、組織「御中」等を所内設定から選択。"
    },
    {
      "key": "matter_title",
      "type": "text",
      "label": "事件名（案件名）",
      "source": "matter",
      "sourcePath": "matter.title",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "case_number",
      "type": "text",
      "label": "事件番号（原文）",
      "source": "matter",
      "sourcePath": "matter.case_number",
      "required": true,
      "defaultPolicy": "from_source",
      "description": "先頭 0 や全角数字を含む文字列として保持する。"
    },
    {
      "key": "court_name",
      "type": "text",
      "label": "裁判所",
      "source": "matter",
      "sourcePath": "matter.court",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "court_department",
      "type": "text",
      "label": "係属部",
      "source": "matter",
      "sourcePath": "matter.court_department",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "plaintiff_name",
      "type": "text",
      "label": "原告（表示）",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "description": "依頼者/相手方のどちらが原告かは案件ごとに人が指定する。氏名一致だけで置換しない。"
    },
    {
      "key": "defendant_name",
      "type": "text",
      "label": "被告（表示）",
      "source": "input",
      "required": true,
      "defaultPolicy": "none"
    },
    {
      "key": "withdrawal_scope",
      "type": "enum",
      "label": "取下げの範囲",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "options": [
        {
          "value": "未入力",
          "label": "未入力"
        },
        {
          "value": "訴えの全部",
          "label": "訴えの全部"
        },
        {
          "value": "訴えの一部",
          "label": "訴えの一部"
        },
        {
          "value": "自由記載",
          "label": "自由記載"
        }
      ],
      "legalJudgement": true
    },
    {
      "key": "withdrawal_scope_detail",
      "type": "multiline",
      "label": "取下げ範囲の詳細（一部・自由記載）",
      "source": "input",
      "required": false,
      "defaultPolicy": "none",
      "outputFormat": "multiline",
      "visibilityRule": {
        "op": "in",
        "field": "withdrawal_scope",
        "values": [
          "訴えの一部",
          "自由記載"
        ]
      },
      "requiredRule": {
        "op": "in",
        "field": "withdrawal_scope",
        "values": [
          "訴えの一部",
          "自由記載"
        ]
      },
      "legalJudgement": true
    },
    {
      "key": "target_parties",
      "type": "multiline",
      "label": "対象当事者",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "outputFormat": "multiline"
    },
    {
      "key": "consent_status",
      "type": "enum",
      "label": "相手方の同意（弁護士確認）",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "options": [
        {
          "value": "未確認",
          "label": "未確認"
        },
        {
          "value": "同意を取得済み（同意書添付）",
          "label": "同意を取得済み（同意書添付）"
        },
        {
          "value": "同意不要と判断（弁護士確認）",
          "label": "同意不要と判断（弁護士確認）"
        },
        {
          "value": "自由記載",
          "label": "自由記載"
        }
      ],
      "description": "必要な同意等の判断を自動化しない。",
      "legalJudgement": true
    }
  ],
  "bodyTag": "body_text",
  "attachments": false,
  "honorificKeys": [
    "recipient_name"
  ],
  "notes": "事件情報・取下げの範囲・対象当事者・本文。必要な同意等の判断を自動化しない（consent_status は legalJudgement）。"
}
