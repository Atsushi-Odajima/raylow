{
  "schemaVersion": 1,
  "kind": "T08_cover_letter",
  "title": "送付書",
  "scope": "negotiation",
  "recipientTypes": [
    "opponent_agent",
    "opponent",
    "court",
    "client",
    "third_party"
  ],
  "fields": [
    {
      "key": "office_name",
      "type": "text",
      "label": "自事務所名",
      "source": "office",
      "sourcePath": "office.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_postcode",
      "type": "text",
      "label": "事務所郵便番号",
      "source": "office",
      "sourcePath": "office.postcode",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_address",
      "type": "text",
      "label": "事務所所在地",
      "source": "office",
      "sourcePath": "office.address",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_phone",
      "type": "text",
      "label": "事務所電話番号",
      "source": "office",
      "sourcePath": "office.phone",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_fax",
      "type": "text",
      "label": "事務所ＦＡＸ番号",
      "source": "office",
      "sourcePath": "office.fax",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "lawyer_name",
      "type": "text",
      "label": "担当弁護士氏名",
      "source": "office",
      "sourcePath": "lawyer.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_organization",
      "type": "text",
      "label": "宛先の所属・組織",
      "source": "recipient",
      "sourcePath": "recipient.organization",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_name",
      "type": "text",
      "label": "宛名",
      "source": "recipient",
      "sourcePath": "recipient.name",
      "required": true,
      "defaultPolicy": "from_source",
      "validationRules": [
        {
          "rule": "noDoubleHonorific"
        }
      ],
      "description": "敬称を含めない。敬称は recipient_honorific（所内設定）で付加し、二重敬称を検出する。"
    },
    {
      "key": "recipient_honorific",
      "type": "text",
      "label": "敬称",
      "source": "recipient",
      "sourcePath": "recipient.honorific",
      "required": false,
      "defaultPolicy": "from_source",
      "description": "人物「先生/様」、組織「御中」等を所内設定から選択。"
    },
    {
      "key": "recipient_postcode",
      "type": "text",
      "label": "宛先郵便番号",
      "source": "recipient",
      "sourcePath": "recipient.postcode",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_address",
      "type": "text",
      "label": "宛先住所",
      "source": "recipient",
      "sourcePath": "recipient.address",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "matter_title",
      "type": "text",
      "label": "案件名",
      "source": "matter",
      "sourcePath": "matter.title",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "client_name",
      "type": "text",
      "label": "依頼者",
      "source": "matter",
      "sourcePath": "matter.client_name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "opponent_name",
      "type": "text",
      "label": "相手方",
      "source": "matter",
      "sourcePath": "matter.opponent_name",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "subject",
      "type": "text",
      "label": "件名",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "maxGraphemes": 100
    },
    {
      "key": "sending_purpose",
      "type": "text",
      "label": "送付目的",
      "source": "input",
      "required": true,
      "defaultPolicy": "none"
    },
    {
      "key": "sending_method",
      "type": "text",
      "label": "送付方法",
      "source": "input",
      "required": false,
      "defaultPolicy": "none"
    },
    {
      "key": "remarks",
      "type": "multiline",
      "label": "連絡事項",
      "source": "input",
      "required": false,
      "defaultPolicy": "none",
      "outputFormat": "multiline"
    }
  ],
  "bodyTag": "body_text",
  "attachments": true,
  "honorificKeys": [
    "recipient_name"
  ],
  "notes": "送付書類名と通数は添付リスト（attachments）で管理する。宛先住所を併記。"
}
