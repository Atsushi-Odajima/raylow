{
  "schemaVersion": 1,
  "kind": "T02_reply_letter",
  "title": "回答書",
  "scope": "negotiation",
  "recipientTypes": [
    "opponent_agent",
    "opponent"
  ],
  "fields": [
    {
      "key": "office_name",
      "type": "text",
      "label": "自事務所名",
      "source": "office",
      "sourcePath": "office.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_postcode",
      "type": "text",
      "label": "事務所郵便番号",
      "source": "office",
      "sourcePath": "office.postcode",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_address",
      "type": "text",
      "label": "事務所所在地",
      "source": "office",
      "sourcePath": "office.address",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_phone",
      "type": "text",
      "label": "事務所電話番号",
      "source": "office",
      "sourcePath": "office.phone",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "office_fax",
      "type": "text",
      "label": "事務所ＦＡＸ番号",
      "source": "office",
      "sourcePath": "office.fax",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "lawyer_name",
      "type": "text",
      "label": "担当弁護士氏名",
      "source": "office",
      "sourcePath": "lawyer.name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_organization",
      "type": "text",
      "label": "宛先の所属・組織",
      "source": "recipient",
      "sourcePath": "recipient.organization",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "recipient_name",
      "type": "text",
      "label": "宛名",
      "source": "recipient",
      "sourcePath": "recipient.name",
      "required": true,
      "defaultPolicy": "from_source",
      "validationRules": [
        {
          "rule": "noDoubleHonorific"
        }
      ],
      "description": "敬称を含めない。敬称は recipient_honorific（所内設定）で付加し、二重敬称を検出する。"
    },
    {
      "key": "recipient_honorific",
      "type": "text",
      "label": "敬称",
      "source": "recipient",
      "sourcePath": "recipient.honorific",
      "required": false,
      "defaultPolicy": "from_source",
      "description": "人物「先生/様」、組織「御中」等を所内設定から選択。"
    },
    {
      "key": "matter_title",
      "type": "text",
      "label": "案件名",
      "source": "matter",
      "sourcePath": "matter.title",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "client_name",
      "type": "text",
      "label": "依頼者",
      "source": "matter",
      "sourcePath": "matter.client_name",
      "required": true,
      "defaultPolicy": "from_source"
    },
    {
      "key": "opponent_name",
      "type": "text",
      "label": "相手方",
      "source": "matter",
      "sourcePath": "matter.opponent_name",
      "required": false,
      "defaultPolicy": "from_source"
    },
    {
      "key": "subject",
      "type": "text",
      "label": "件名",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "maxGraphemes": 100
    },
    {
      "key": "reference_document_title",
      "type": "text",
      "label": "回答対象の文書名",
      "source": "input",
      "required": true,
      "defaultPolicy": "none"
    },
    {
      "key": "reference_document_date_raw",
      "type": "date",
      "label": "回答対象の文書日付（原文）",
      "source": "input",
      "required": false,
      "defaultPolicy": "none",
      "outputFormat": "plain",
      "validationRules": [
        {
          "rule": "isoDateOrRaw"
        }
      ],
      "description": "原文（raw）を保持し、そのまま差し込む。ISO 値は解析候補として別に保持する。"
    },
    {
      "key": "reply_policy",
      "type": "enum",
      "label": "回答方針",
      "source": "input",
      "required": true,
      "defaultPolicy": "none",
      "options": [
        {
          "value": "未入力",
          "label": "未入力"
        },
        {
          "value": "回答を留保する",
          "label": "回答を留保する"
        },
        {
          "value": "請求には応じられない",
          "label": "請求には応じられない"
        },
        {
          "value": "一部について協議に応じる",
          "label": "一部について協議に応じる"
        },
        {
          "value": "自由記載",
          "label": "自由記載"
        }
      ],
      "description": "既定の認諾等を入れない。弁護士が選択する。",
      "legalJudgement": true
    },
    {
      "key": "reply_items",
      "type": "array",
      "label": "回答項目",
      "source": "input",
      "required": false,
      "defaultPolicy": "none",
      "itemFields": [
        {
          "key": "no",
          "type": "text",
          "label": "番号",
          "required": true,
          "maxGraphemes": 10
        },
        {
          "key": "item",
          "type": "text",
          "label": "回答項目",
          "required": true
        },
        {
          "key": "reply_text",
          "type": "multiline",
          "label": "回答本文",
          "required": true
        }
      ],
      "maxItems": 100
    }
  ],
  "bodyTag": "body_text",
  "attachments": true,
  "honorificKeys": [
    "recipient_name"
  ],
  "notes": "回答方針（reply_policy）に既定の認諾等を入れない。答弁書（T13）とは別種類。"
}
