# RayLaw 環境変数（値は入れないこと。ローカル開発では .env にコピーして各自設定）
# --- 共通 ---
NODE_ENV=development
RAYLOW_PUBLIC_ORIGIN=http://localhost:5173
# --- Postgres（Supabase local の場合: postgresql://postgres:postgres@127.0.0.1:54322/postgres）---
DATABASE_URL=
# BFF が接続するログインロール（RLS 対象。superuser 不可）
DATABASE_URL_APP=
# worker が接続するロール（service role 相当。worker 専用）
DATABASE_URL_SERVICE=
# --- 認証 ---
# local = BFF 内蔵の資格情報ストア（開発/テスト用）、supabase = Supabase Auth (GoTrue)
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# server_sessions の refresh token / TOTP secret 暗号化鍵（32byte base64）
SESSION_ENCRYPTION_KEY=
# CSRF/Origin allowlist（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# --- Storage ---
# local = .data/blobs 配下、supabase = Supabase private Storage、postgres = private.blobs（bytea。FS が揮発する単一コンテナ配備向け）
BLOB_STORE=local
BLOB_LOCAL_DIR=.data/blobs
SUPABASE_STORAGE_BUCKET=raylow-private
# --- API ---
API_PORT=3001
API_HOST=127.0.0.1
# --- worker ---
WORKER_ID=
SOFFICE_BIN=soffice
FONTS_DIR=./assets/fonts
PYTHON_BIN=python3
DOCUMENT_WORKER_DIR=./workers/documents
RENDER_TMP_DIR=.data/tmp
# --- scanner (ClamAV) ---
# clamd の TCP アドレス。未設定時は scan_status=skipped ではなく fail closed（quarantine 維持）
CLAMD_HOST=
CLAMD_PORT=3310
# 開発専用: ClamAV 無しでも検査完了扱いにする（本番で true にしない）
DEV_ALLOW_UNSCANNED=false
# --- 単一コンテナ配備（infra/docker/demo.Dockerfile。Render 等の PaaS 1 サービス。docs/deploy-demo.md）---
# 設定時: API が web(dist) を同一 origin で配信する。待受ポートは API_PORT → PORT（PaaS 注入）→ 3001 の順
WEB_DIST_DIR=
# 起動時に migrate / seed を実行する（seed は投入済みなら何もしない）
RAYLOW_MIGRATE_ON_BOOT=false
RAYLOW_SEED_ON_BOOT=false
# デモ seed の全ユーザーに同じパスワード（12 文字以上）/ TOTP secret（base32）を使う。値は配備時に生成して環境変数で渡し、repo に書かない
SEED_DEMO_PASSWORD=
SEED_DEMO_TOTP_SECRET=
